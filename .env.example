# ============================================================
# WebScope — Environment Variables Template
# Copy to .env.production and fill in values
# NEVER commit .env.production to git!
# ============================================================

# ------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------
WEBSCOPE_HOST=0.0.0.0
WEBSCOPE_PORT=8000
WEBSCOPE_DB_PATH=/data/webscope.db
WEBSCOPE_ALLOW_PRIVATE=0
WEBSCOPE_PUBLIC_URL=https://demo.webscope.io

# ------------------------------------------------------------
# Authentication (optional for demo)
# Set WEBSCOPE_AUTH_PASSWORD to enable password protection
# ------------------------------------------------------------
# WEBSCOPE_AUTH_PASSWORD=your-secure-password-here
# WEBSCOPE_AUTH_USER=admin

# ------------------------------------------------------------
# Playwright / Browser
# ------------------------------------------------------------
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# ------------------------------------------------------------
# External Services (optional)
# ------------------------------------------------------------
# Telegram Bot for alerts
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_CHAT_ID=your-chat-id

# ------------------------------------------------------------
# Payment Providers (for billing)
# ------------------------------------------------------------
# Stripe
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ЮKassa (Russia)
# YOOKASSA_SHOP_ID=...
# YOOKASSA_SECRET_KEY=...

# ------------------------------------------------------------
# Email (for reports/alerts)
# ------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASSWORD=...
# SMTP_FROM=WebScope <noreply@webscope.io>

# ------------------------------------------------------------
# Redis (for queues, caching, sessions)
# ------------------------------------------------------------
# REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------
# Sentry / Monitoring (optional)
# ------------------------------------------------------------
# SENTRY_DSN=https://...@sentry.io/...

# ------------------------------------------------------------
# Feature Flags
# ------------------------------------------------------------
# ENABLE_WATCHDOG=1
# ENABLE_PAY_PER_SCAN=1
# ENABLE_BILLING=1